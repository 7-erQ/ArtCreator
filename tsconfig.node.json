{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/GenerationEffectColorWander.ts",
    "src/renderer/src/GenerationEffectContourTrace.ts",
    "src/renderer/src/GenerationEffectPixelRecompose.ts",
    "src/renderer/src/GenerationEffectStage.ts",
    "src/renderer/src/GenerationEffectScheme.ts"
  ]
}
